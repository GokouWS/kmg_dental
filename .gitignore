# ----------------------------------------------------------------
# WordPress
# ----------------------------------------------------------------
# Ignore the core WordPress installation. In a Docker setup, this is managed
# by the image, but this is a good safeguard for other environments.
apps/wordpress/wp-admin/
apps/wordpress/wp-includes/
apps/wordpress/wp-login.php
apps/wordpress/wp-cron.php
apps/wordpress/xmlrpc.php

# Ignore the sensitive config file. CRITICAL.
apps/wordpress/wp-config.php

# Ignore user-generated content and transient files.
apps/wordpress/wp-content/uploads/
apps/wordpress/wp-content/upgrade/
apps/wordpress/wp-content/backups/
apps/wordpress/wp-content/cache/

# Ignore WordPress debug logs.
apps/wordpress/wp-content/debug.log

# ----------------------------------------------------------------
# Dependencies & Build Artifacts
# ----------------------------------------------------------------
# PHP dependencies managed by Composer (specific to WordPress app).
apps/wordpress/vendor/

# Node.js dependencies.
node_modules/

# Log files.
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ----------------------------------------------------------------
# OS & Editor Files
# ----------------------------------------------------------------
# OS-generated files.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Code Editor settings.
/.vscode/
